{
  "name": "@game-guide-hub/desktop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n renderer,main,electron \"vite --host 127.0.0.1\" \"tsc -p tsconfig.main.json --watch --preserveWatchOutput\" \"wait-on http://127.0.0.1:5173 dist/electron/main/index.js && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron dist/electron/main/index.js\"",
    "build": "tsc -p tsconfig.main.json && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@game-guide-hub/api-client": "workspace:*",
    "@game-guide-hub/config": "workspace:*",
    "@game-guide-hub/hooks": "workspace:*",
    "@game-guide-hub/icons": "workspace:*",
    "@game-guide-hub/theme": "workspace:*",
    "@game-guide-hub/types": "workspace:*",
    "@game-guide-hub/ui": "workspace:*",
    "@game-guide-hub/utils": "workspace:*",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.0.4",
    "@tanstack/react-query": "^5.83.0",
    "electron": "^39.8.1",
    "framer-motion": "^12.23.12",
    "gsap": "^3.15.0",
    "postprocessing": "^6.39.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "6.30.4",
    "three": "^0.185.1",
    "zustand": "^5.0.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/three": "^0.185.3",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "cross-env": "^10.0.0",
    "typescript": "^5.8.3",
    "vite": "^6.4.1",
    "wait-on": "^8.0.4"
  }
}
